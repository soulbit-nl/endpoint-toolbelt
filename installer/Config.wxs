<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration values (README, "Configuration"), written to HKLM\SOFTWARE\EndpointToolbelt\Config
  as REG_SZ at install and upgrade.

  The remember-property pattern, per value: before AppSearch a value given on the command line
  is saved (SaveCmdLine_*); AppSearch then finds the value already stored; after AppSearch the
  saved command-line value is put back (RestoreCmdLine_*). So a value on the command line wins,
  and otherwise the stored value survives an upgrade (the old product removes its values first).
  A value is written only when its property has one.

  The properties are deliberately not Secure: when a standard user starts a repair of this
  per-machine product, Windows Installer does not pass public properties that are not Secure to
  the elevated part, so new values cannot be set that way; an administrator or SYSTEM (Intune)
  can pass any of them.

  Keep the entries identical apart from the names.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="Configuration" Directory="InstallFolder">
      <Component Id="Config_FullResetCooldownHours" Condition="FULLRESETCOOLDOWNHOURS" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="FullResetCooldownHours" Type="string" Value="[FULLRESETCOOLDOWNHOURS]" KeyPath="yes" />
      </Component>
      <Component Id="Config_WURepairCooldownHours" Condition="WUREPAIRCOOLDOWNHOURS" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="WURepairCooldownHours" Type="string" Value="[WUREPAIRCOOLDOWNHOURS]" KeyPath="yes" />
      </Component>
      <Component Id="Config_WUDeploymentDelayDays" Condition="WUDEPLOYMENTDELAYDAYS" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="WUDeploymentDelayDays" Type="string" Value="[WUDEPLOYMENTDELAYDAYS]" KeyPath="yes" />
      </Component>
      <Component Id="Config_WUMinFreeGB" Condition="WUMINFREEGB" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="WUMinFreeGB" Type="string" Value="[WUMINFREEGB]" KeyPath="yes" />
      </Component>
      <Component Id="Config_WURemoveStalePackages" Condition="WUREMOVESTALEPACKAGES" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="WURemoveStalePackages" Type="string" Value="[WUREMOVESTALEPACKAGES]" KeyPath="yes" />
      </Component>
      <Component Id="Config_SupportText" Condition="SUPPORTTEXT" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="SupportText" Type="string" Value="[SUPPORTTEXT]" KeyPath="yes" />
      </Component>
      <Component Id="Config_SupportUrl" Condition="SUPPORTURL" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="SupportUrl" Type="string" Value="[SUPPORTURL]" KeyPath="yes" />
      </Component>
      <Component Id="Config_UserRateLimitPerHour" Condition="USERRATELIMIT" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="UserRateLimitPerHour" Type="string" Value="[USERRATELIMIT]" KeyPath="yes" />
      </Component>
      <Component Id="Config_UpdateCheck" Condition="UPDATECHECK" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="UpdateCheck" Type="string" Value="[UPDATECHECK]" KeyPath="yes" />
      </Component>
      <!-- That the device's choice was made, readable by every user: the setup's screens run
           without elevation and cannot read the Config key, so the first screen asks again only
           where this is missing (a first install, or an upgrade of a device where nobody chose). -->
      <Component Id="Setup_UpdateCheckAsked" Condition="UPDATECHECK" Bitness="always64">
        <RegistryKey Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Setup" ForceCreateOnInstall="yes">
          <PermissionEx Sddl="D:PAI(A;CI;KA;;;SY)(A;CI;KA;;;BA)(A;CI;KR;;;BU)" />
          <RegistryValue Name="UpdateCheckAsked" Type="string" Value="1" KeyPath="yes" />
        </RegistryKey>
      </Component>
      <Component Id="Config_AllowMachineWideOnMultiSession" Condition="ALLOWMULTISESSIONRESET" Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="AllowMachineWideOnMultiSession" Type="string" Value="[ALLOWMULTISESSIONRESET]" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Property Id="FULLRESETCOOLDOWNHOURS">
      <RegistrySearch Id="Find_FullResetCooldownHours" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="FullResetCooldownHours" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_FullResetCooldownHours" Id="SavedFullResetCooldownHours" Value="[FULLRESETCOOLDOWNHOURS]" Before="AppSearch" Sequence="first" Condition="FULLRESETCOOLDOWNHOURS" />
    <SetProperty Action="RestoreCmdLine_FullResetCooldownHours" Id="FULLRESETCOOLDOWNHOURS" Value="[SavedFullResetCooldownHours]" After="AppSearch" Sequence="first" Condition="SavedFullResetCooldownHours" />

    <Property Id="WUREPAIRCOOLDOWNHOURS">
      <RegistrySearch Id="Find_WURepairCooldownHours" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="WURepairCooldownHours" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_WURepairCooldownHours" Id="SavedWURepairCooldownHours" Value="[WUREPAIRCOOLDOWNHOURS]" Before="AppSearch" Sequence="first" Condition="WUREPAIRCOOLDOWNHOURS" />
    <SetProperty Action="RestoreCmdLine_WURepairCooldownHours" Id="WUREPAIRCOOLDOWNHOURS" Value="[SavedWURepairCooldownHours]" After="AppSearch" Sequence="first" Condition="SavedWURepairCooldownHours" />

    <Property Id="WUDEPLOYMENTDELAYDAYS">
      <RegistrySearch Id="Find_WUDeploymentDelayDays" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="WUDeploymentDelayDays" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_WUDeploymentDelayDays" Id="SavedWUDeploymentDelayDays" Value="[WUDEPLOYMENTDELAYDAYS]" Before="AppSearch" Sequence="first" Condition="WUDEPLOYMENTDELAYDAYS" />
    <SetProperty Action="RestoreCmdLine_WUDeploymentDelayDays" Id="WUDEPLOYMENTDELAYDAYS" Value="[SavedWUDeploymentDelayDays]" After="AppSearch" Sequence="first" Condition="SavedWUDeploymentDelayDays" />

    <Property Id="WUMINFREEGB">
      <RegistrySearch Id="Find_WUMinFreeGB" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="WUMinFreeGB" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_WUMinFreeGB" Id="SavedWUMinFreeGB" Value="[WUMINFREEGB]" Before="AppSearch" Sequence="first" Condition="WUMINFREEGB" />
    <SetProperty Action="RestoreCmdLine_WUMinFreeGB" Id="WUMINFREEGB" Value="[SavedWUMinFreeGB]" After="AppSearch" Sequence="first" Condition="SavedWUMinFreeGB" />

    <Property Id="WUREMOVESTALEPACKAGES">
      <RegistrySearch Id="Find_WURemoveStalePackages" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="WURemoveStalePackages" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_WURemoveStalePackages" Id="SavedWURemoveStalePackages" Value="[WUREMOVESTALEPACKAGES]" Before="AppSearch" Sequence="first" Condition="WUREMOVESTALEPACKAGES" />
    <SetProperty Action="RestoreCmdLine_WURemoveStalePackages" Id="WUREMOVESTALEPACKAGES" Value="[SavedWURemoveStalePackages]" After="AppSearch" Sequence="first" Condition="SavedWURemoveStalePackages" />

    <Property Id="SUPPORTTEXT">
      <RegistrySearch Id="Find_SupportText" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="SupportText" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_SupportText" Id="SavedSupportText" Value="[SUPPORTTEXT]" Before="AppSearch" Sequence="first" Condition="SUPPORTTEXT" />
    <SetProperty Action="RestoreCmdLine_SupportText" Id="SUPPORTTEXT" Value="[SavedSupportText]" After="AppSearch" Sequence="first" Condition="SavedSupportText" />

    <Property Id="SUPPORTURL">
      <RegistrySearch Id="Find_SupportUrl" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="SupportUrl" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_SupportUrl" Id="SavedSupportUrl" Value="[SUPPORTURL]" Before="AppSearch" Sequence="first" Condition="SUPPORTURL" />
    <SetProperty Action="RestoreCmdLine_SupportUrl" Id="SUPPORTURL" Value="[SavedSupportUrl]" After="AppSearch" Sequence="first" Condition="SavedSupportUrl" />

    <Property Id="USERRATELIMIT">
      <RegistrySearch Id="Find_UserRateLimitPerHour" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="UserRateLimitPerHour" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_UserRateLimitPerHour" Id="SavedUserRateLimitPerHour" Value="[USERRATELIMIT]" Before="AppSearch" Sequence="first" Condition="USERRATELIMIT" />
    <SetProperty Action="RestoreCmdLine_UserRateLimitPerHour" Id="USERRATELIMIT" Value="[SavedUserRateLimitPerHour]" After="AppSearch" Sequence="first" Condition="SavedUserRateLimitPerHour" />

    <Property Id="ALLOWMULTISESSIONRESET">
      <RegistrySearch Id="Find_AllowMachineWideOnMultiSession" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="AllowMachineWideOnMultiSession" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_AllowMachineWideOnMultiSession" Id="SavedAllowMachineWideOnMultiSession" Value="[ALLOWMULTISESSIONRESET]" Before="AppSearch" Sequence="first" Condition="ALLOWMULTISESSIONRESET" />
    <SetProperty Action="RestoreCmdLine_AllowMachineWideOnMultiSession" Id="ALLOWMULTISESSIONRESET" Value="[SavedAllowMachineWideOnMultiSession]" After="AppSearch" Sequence="first" Condition="SavedAllowMachineWideOnMultiSession" />

    <!-- The version check for the whole device: "0" is off (no request), from the command line or
         the first screen's check box. A user's own choice in About comes before it; the policy value
         UpdateCheck locks it. Secure, so the first screen's choice reaches the elevated install. -->
    <Property Id="UPDATECHECK" Secure="yes">
      <RegistrySearch Id="Find_UpdateCheck" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Config" Name="UpdateCheck" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdLine_UpdateCheck" Id="SavedUpdateCheck" Value="[UPDATECHECK]" Before="AppSearch" Sequence="first" Condition="UPDATECHECK" />
    <SetProperty Action="RestoreCmdLine_UpdateCheck" Id="UPDATECHECK" Value="[SavedUpdateCheck]" After="AppSearch" Sequence="first" Condition="SavedUpdateCheck" />
    <!-- Whether the device's choice was made (Setup_UpdateCheckAsked), read where the screens run. -->
    <Property Id="ETBUPDATECHECKASKED">
      <RegistrySearch Id="Find_UpdateCheckAsked" Root="HKLM" Key="SOFTWARE\EndpointToolbelt\Setup" Name="UpdateCheckAsked" Type="raw" Bitness="always64" />
    </Property>

  </Fragment>
</Wix>
