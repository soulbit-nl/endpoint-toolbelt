<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The compiled repair engine: a console program the service starts as SYSTEM. No PowerShell is
    hosted; in-box cmdlets run only through the allow-listed runner in EndpointToolbelt.Platform.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>EndpointToolbelt.Engine</RootNamespace>
    <AssemblyName>EndpointToolbelt.Engine</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EndpointToolbelt.Contracts\EndpointToolbelt.Contracts.csproj" />
    <ProjectReference Include="..\EndpointToolbelt.Platform\EndpointToolbelt.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EndpointToolbelt.Tests" />
  </ItemGroup>

</Project>
