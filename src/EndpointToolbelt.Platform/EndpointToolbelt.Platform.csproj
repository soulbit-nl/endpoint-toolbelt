<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code the service and the engine both need: the CMTrace writer, the link-safe file
    API, the product's registry keys, the IME log pattern table, the process runner and the
    in-box cmdlet runner, in one place, never copied.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>EndpointToolbelt.Platform</RootNamespace>
    <AssemblyName>EndpointToolbelt.Platform</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EndpointToolbelt.Contracts\EndpointToolbelt.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EndpointToolbelt.Tests" />
  </ItemGroup>

</Project>
