<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>EndpointToolbelt.App</RootNamespace>
    <AssemblyName>EndpointToolbelt</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\EndpointToolbelt.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EndpointToolbelt.Contracts\EndpointToolbelt.Contracts.csproj" />
    <ProjectReference Include="..\EndpointToolbelt.Platform\EndpointToolbelt.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\EndpointToolbelt.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EndpointToolbelt.Tests" />
  </ItemGroup>

</Project>
