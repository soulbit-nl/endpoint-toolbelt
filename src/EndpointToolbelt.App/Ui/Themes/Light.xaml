<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- SoulBit colours: charcoal buttons, the darker brand orange for links and focus; severity is always written out as well, never colour alone. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F4F4F4" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListBackground" Color="#EEEEEE" />
    <SolidColorBrush x:Key="TextPrimary" Color="#2F2F2F" />
    <SolidColorBrush x:Key="TextMuted" Color="#616161" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C6C6C6" />
    <SolidColorBrush x:Key="AccentBackground" Color="#4E4E4E" />
    <SolidColorBrush x:Key="AccentHover" Color="#2F2F2F" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LinkText" Color="#A14B0D" />
    <SolidColorBrush x:Key="DangerBackground" Color="#962D2D" />
    <SolidColorBrush x:Key="DangerHover" Color="#7A2424" />
    <SolidColorBrush x:Key="DangerText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToneSuccess" Color="#1E7A3C" />
    <SolidColorBrush x:Key="ToneWarning" Color="#9A5A00" />
    <SolidColorBrush x:Key="ToneError" Color="#B42828" />
    <SolidColorBrush x:Key="ToneInfo" Color="#2A6FA3" />
    <SolidColorBrush x:Key="ToneChange" Color="#6A4C9C" />
    <SolidColorBrush x:Key="ToneNeutral" Color="#2F2F2F" />
    <SolidColorBrush x:Key="LogBackground" Color="#EEEEEE" />
    <SolidColorBrush x:Key="BannerBackground" Color="#FFF4E0" />
    <SolidColorBrush x:Key="FocusBrush" Color="#A14B0D" />
    <!-- Disabled buttons: dimmed as a whole; the same colours as when enabled. -->
    <sys:Double x:Key="DisabledOpacity">0.45</sys:Double>
    <SolidColorBrush x:Key="PrimaryDisabledBackground" Color="#4E4E4E" />
    <SolidColorBrush x:Key="PrimaryDisabledText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryDisabledBorder" Color="#4E4E4E" />
    <SolidColorBrush x:Key="DisabledText" Color="#2F2F2F" />
    <SolidColorBrush x:Key="DisabledBorder" Color="#C6C6C6" />
    <!-- The helper character: the brand orange body and dark eyes on every theme; its bit in charcoal. -->
    <SolidColorBrush x:Key="HelperBody" Color="#FF914D" />
    <SolidColorBrush x:Key="HelperEye" Color="#2F2F2F" />
    <SolidColorBrush x:Key="HelperBit" Color="#4E4E4E" />
    <SolidColorBrush x:Key="HelperSoft" Color="#A6A6A6" />
    <SolidColorBrush x:Key="HelperMark" Color="#FFFFFF" />
    <!-- The For IT tiles' icons, one colour each (blue, violet, pink, cyan, indigo, orchid): never green, amber or red, which stay for results; each at least 3:1 against SurfaceBackground (a test measures it). -->
    <SolidColorBrush x:Key="TileIconApps" Color="#1F5FA8" />
    <SolidColorBrush x:Key="TileIconSignIn" Color="#5B3FC0" />
    <SolidColorBrush x:Key="TileIconMicrosoft365" Color="#A8306A" />
    <SolidColorBrush x:Key="TileIconWindows" Color="#00707F" />
    <SolidColorBrush x:Key="TileIconDefender" Color="#3949AB" />
    <SolidColorBrush x:Key="TileIconNetwork" Color="#8A3FA8" />
</ResourceDictionary>
