<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- SoulBit colours: light-grey buttons, the brand orange for links and focus. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#262626" />
    <SolidColorBrush x:Key="ListBackground" Color="#222222" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextMuted" Color="#A9A9A9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="AccentBackground" Color="#D6D6D6" />
    <SolidColorBrush x:Key="AccentHover" Color="#F3F3F3" />
    <SolidColorBrush x:Key="AccentText" Color="#1A1A1A" />
    <SolidColorBrush x:Key="LinkText" Color="#FF914D" />
    <SolidColorBrush x:Key="DangerBackground" Color="#D9625E" />
    <SolidColorBrush x:Key="DangerHover" Color="#E5807C" />
    <SolidColorBrush x:Key="DangerText" Color="#101114" />
    <SolidColorBrush x:Key="ToneSuccess" Color="#6CCB8A" />
    <SolidColorBrush x:Key="ToneWarning" Color="#F0B45A" />
    <SolidColorBrush x:Key="ToneError" Color="#F08A86" />
    <SolidColorBrush x:Key="ToneInfo" Color="#7FB4F0" />
    <SolidColorBrush x:Key="ToneChange" Color="#B49AE8" />
    <SolidColorBrush x:Key="ToneNeutral" Color="#E0E0E0" />
    <SolidColorBrush x:Key="LogBackground" Color="#222222" />
    <SolidColorBrush x:Key="BannerBackground" Color="#3D3320" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF914D" />
    <!-- Disabled buttons: dimmed as a whole; the same colours as when enabled. -->
    <sys:Double x:Key="DisabledOpacity">0.45</sys:Double>
    <SolidColorBrush x:Key="PrimaryDisabledBackground" Color="#D6D6D6" />
    <SolidColorBrush x:Key="PrimaryDisabledText" Color="#1A1A1A" />
    <SolidColorBrush x:Key="PrimaryDisabledBorder" Color="#D6D6D6" />
    <SolidColorBrush x:Key="DisabledText" Color="#E0E0E0" />
    <SolidColorBrush x:Key="DisabledBorder" Color="#4A4A4A" />
    <!-- The helper character: the brand orange body and dark eyes on every theme; its bit in light grey. -->
    <SolidColorBrush x:Key="HelperBody" Color="#FF914D" />
    <SolidColorBrush x:Key="HelperEye" Color="#2F2F2F" />
    <SolidColorBrush x:Key="HelperBit" Color="#A6A6A6" />
    <SolidColorBrush x:Key="HelperSoft" Color="#6E6E6E" />
    <SolidColorBrush x:Key="HelperMark" Color="#1A1A1A" />
</ResourceDictionary>
